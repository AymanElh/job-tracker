# ── DATABASE CONFIGURATION ────────────────────────────────────
# Root credentials (used for initialization and backups)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=admin_strong_password_here
MONGO_INIT_DATABASE=jobtrackr

# Application-specific credentials
MONGO_APP_USER=jobtrackr_app
MONGO_APP_PASS=app_strong_password_here

# Full MongoDB URI for the API
# Format: mongodb://[user]:[pass]@mongo:27017/[db]?authSource=jobtrackr
# Note: Special characters in password must be URL encoded (! -> %21, @ -> %40)
MONGO_URI=mongodb://jobtrackr_app:app_strong_password_here@mongo:27017/jobtrackr?authSource=jobtrackr

# ── MONGO EXPRESS (DB UI) ─────────────────────────────────────
ME_USER=admin
ME_PASS=ui_strong_password_here

# ── API CONFIGURATION ─────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# JWT Security (Generate strong random strings for these)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / Frontend connection
FRONTEND_URL=http://localhost

# ── WEB FRONTEND CONFIGURATION ────────────────────────────────
# Baked into build - must be accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost/api/v1


# ── Google drive api configuration ────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_DRIVE_FOLDER_ID=your_personal_folder_id

# ── BACKUP & CLOUD CONFIGURATION ──────────────────────────────
# Name of your rclone remote (as configured via 'rclone config')
RCLONE_REMOTE=gdrive
BACKUP_RETENTION_DAYS=7
